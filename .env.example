# Valores de desenvolvimento local. O docker-compose.yml já usa estes mesmos valores
# como padrão: copie este arquivo para .env só se precisar mudar algum deles,
# por exemplo quando uma porta já está em uso na sua máquina.

# Portas publicadas no host
COMPOSE_PROJECT_NAME=puc-asm-grupo3
FRONTEND_PORT=5173
BFF_PORT=3000
KEYCLOAK_PORT=8080
KAFKA_UI_PORT=8081
GRAFANA_PORT=3001

# Ao mudar FRONTEND_PORT, atualize redirectUris/webOrigins do client
# encurta-frontend em infra/keycloak/encurta-realm.json e recrie o Keycloak.

# PostgreSQL: senha do superusuário e dos usuários de cada database.
# Só valem na criação do volume; para trocar depois, rode docker compose down -v.
POSTGRES_PASSWORD=postgres
LINKS_DB_PASSWORD=links_pass
STATS_DB_PASSWORD=stats_pass

# Keycloak: senha do usuário admin do console de administração
KEYCLOAK_ADMIN_PASSWORD=admin
# Grafana local (usado com --profile observability)
GRAFANA_ADMIN_PASSWORD=admin

# Usados com docker-compose.prod.yml
# IMAGE_NAMESPACE=ghcr.io/<proprietario>/encurta
# IMAGE_TAG=latest
